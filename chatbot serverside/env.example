# Same PostgreSQL database the Flask backend uses.
# Must use the asyncpg driver. Do NOT add ?sslmode=... (SSL is enabled in app/core/database.py).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME

# MUST be identical to JWT_SECRET_KEY in Backend/.env - the chatbot verifies tokens issued by Flask.
JWT_SECRET_KEY=change-me

# Google AI Studio key (primary model: gemini-2.5-flash)
GOOGLE_API_KEY=
# Groq key (automatic fallback model: llama-3.3-70b-versatile)
GROQ_API_KEY=

# true -> enables /docs
DEBUG=false

# Optional LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=attendify-chatbot
